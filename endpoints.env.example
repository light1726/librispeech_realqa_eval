# API endpoints & keys for the realtime inference backends.
#
# Copy to `endpoints.env`, fill in what you use, and pass to the runner:
#   python -m backends.runner --env-file endpoints.env --model <model> ...
#
# Lines are KEY=VALUE (quotes optional); `#` starts a comment. The runner
# loads the file into the environment before constructing clients, using
# the standard provider variable names below. Never commit the
# filled-in file.

# ── Gemini Live ─────────────────────────────────────────────────────
# Official names; either works.
# GEMINI_API_KEY=
# GOOGLE_API_KEY=

# ── GPT Realtime ────────────────────────────────────────────────────
# Dedicated names (usable alongside a different GPT-Live account); falls
# back to the generic OPENAI_API_KEY / OPENAI_BASE_URL when unset.
# OPENAI_REALTIME_API_KEY=
# OPENAI_REALTIME_BASE_URL=https://api.openai.com/v1   # or a relay
# Use --turn-detection server_vad (semantic_vad may never auto-respond
# through some relays).

# ── GPT Live ────────────────────────────────────────────────────────
# Dedicated names first (different key from GPT Realtime is fine); the
# AZURE_OPENAI_* pair and GPT_DEPLOYMENT_NAME also work for Azure
# deployments, as does the generic OPENAI_* fallback.
# OPENAI_LIVE_API_KEY=
# OPENAI_LIVE_BASE_URL=https://api.openai.com/v1

# ── Qwen (DashScope realtime) ───────────────────────────────────────
# Official DashScope name. International and China endpoints use
# separate accounts — set the key matching your account's endpoint.
# DASHSCOPE_API_KEY=
# China endpoint (set when using a China-mainland account):
# QWEN_AUDIO_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
